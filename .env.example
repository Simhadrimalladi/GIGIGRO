# Example Environment Variables
# Copy this file to .env.local and replace the values with your actual credentials

# The base URL of your website (used for SEO and canonical links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Analytics (Optional)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# Email Service (For when you connect the contact/quote forms to a backend)
# RESEND_API_KEY=re_your_api_key_here
# CONTACT_EMAIL_ADDRESS=hello@dijigro.com
